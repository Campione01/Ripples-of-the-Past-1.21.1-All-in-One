#version 330 core
// The erased space where the shader pack does not draw it: on packs that do not declare its marker and with no shaders. The functions
// are the shader pack's Lib/Compat/KingCrimsonVoid.glsl, the accepted look. Generated by the pack's tools/t82/make_cosmos_sources.py;
// change the generator's input, not this file.

uniform mat4 InvViewProj;
uniform float PixelAngle;
in vec2 texCoord;
out vec4 fragColor;

#define saturate(x) clamp(x, 0.0, 1.0)

bool isMarked(float depth) {
    return floatBitsToUint(depth) == 0x3f7fffffu;
}

uniform sampler2D Sampler0;
uniform vec2 MaskSize;
uniform int UseMask;

// How much of this display pixel is the void: the mask's pixels eroded by one, because the upscaler's edge and the mask's jitter need
// not agree; that edge then shows what the pack drew for the shell, which is dark, and never eats a plate or a creature.
float voidCoverage(vec2 uv) {
    if (UseMask == 0) return 1.0;
    ivec2 last = ivec2(MaskSize) - 1;
    vec2 p = uv * MaskSize - 0.5;
    ivec2 c = ivec2(floor(p));
    vec2 f = p - floor(p);
    float m[16];
    for (int j = 0; j < 4; j++) {
        for (int i = 0; i < 4; i++) {
            m[i + j * 4] = isMarked(texelFetch(Sampler0, clamp(c + ivec2(i - 1, j - 1), ivec2(0), last), 0).r) ? 1.0 : 0.0;
        }
    }
    float e00 = min(min(min(m[0], m[1]), min(m[2], m[4])), min(min(m[5], m[6]), min(min(m[8], m[9]), m[10])));
    float e10 = min(min(min(m[1], m[2]), min(m[3], m[5])), min(min(m[6], m[7]), min(min(m[9], m[10]), m[11])));
    float e01 = min(min(min(m[4], m[5]), min(m[6], m[8])), min(min(m[9], m[10]), min(min(m[12], m[13]), m[14])));
    float e11 = min(min(min(m[5], m[6]), min(m[7], m[9])), min(min(m[10], m[11]), min(min(m[13], m[14]), m[15])));
    return mix(mix(e00, e10, f.x), mix(e01, e11, f.x), f.y);
}

const mat3 KCV_TURN = mat3(0.6124, 0.6124, -0.5, -0.3536, 0.7071, 0.6124, 0.7071, -0.3536, 0.6124);
const mat3 KCV_OCTAVE = mat3(0.33338, 0.56034, -0.71817, -0.87887, 0.32651, -0.15323, 0.15162, 0.69596, 0.61339) * 1.93;

// Filaments: the zero sets of a warped gyroid, finer at each octave. Near 0 on a filament, larger away from it.
// detail: how many octaves the render resolution can hold; finer ones would only alias, and DLSS shows that as a mosaic.
float KcvFilaments(vec3 p, const int octaves, float detail){
	float d = 0.0;
	float z = 1.0;
	float trk = 1.0;
	for (int i = 0; i < octaves; i++){
		p += sin(p.zxy * 0.75 * trk + float(i) * 1.7) * 1.05;
		d += abs(dot(cos(p), sin(p.yzx))) * z * saturate(detail - float(i));
		z *= 0.62;
		trk *= 1.4;
		p = KCV_OCTAVE * p;
	}
	return d;
}

// One great cloud: a warped band across the sky with a brighter heart, so that most of the sky stays dark.
float KcvCloudMask(vec3 d, out float bandCoord){
	vec3 w = d + sin(d.zxy * vec3(2.3, 1.9, 2.7) + vec3(0.7, 2.1, 4.4)) * 0.26;
	w += sin(w.yzx * vec3(4.7, 5.3, 4.1) + vec3(3.3, 1.2, 5.1)) * 0.07;
	bandCoord = dot(w, normalize(vec3(0.36, 0.78, -0.51)));
	float band = exp(-bandCoord * bandCoord * 3.6);
	float heart = pow(saturate(dot(w, normalize(vec3(0.72, 0.21, 0.66))) * 0.5 + 0.5), 4.0);
	float lobe = pow(saturate(dot(w, normalize(vec3(-0.64, -0.33, -0.69))) * 0.5 + 0.5), 6.0);
	return band * (0.40 + heart * 0.42 + lobe * 0.45) + heart * 0.05 + 0.17;
}

vec3 KcvNebula(vec3 d, float mask, float detail, out float transmittance){
	const int steps = 8;

	vec3 sum = vec3(0.0);
	float tr = 1.0;
	// Turned and shifted off the origin: the gyroid is symmetric about the world axes, a cross would show when looking along one.
	vec3 q = KCV_TURN * d;
	float rift = saturate(1.2 - KcvFilaments(q * 1.15 + vec3(3.1, 7.7, 1.9), 3, 3.0) * 0.72);
	float cover = mask * (0.25 + rift * 1.25);
	// The finest filaments once per ray: through eight shells they would only comb the cloud into hairs.
	float fine = KcvFilaments(q * 31.0 + vec3(1.3, 6.1, 4.7), 2, detail - 4.0);
	for (int i = 0; i < steps; i++){
		vec3 p = q * (2.2 + float(i) * 0.19) + vec3(5.3, 2.9, 7.1);

		// The cloud's edge is eaten by the fine detail: the thinner the cover, the less of the detail survives.
		float n = saturate(1.0 - (KcvFilaments(p, 4, detail) + fine * 0.15) * 0.40);
		float gas = saturate((n - (0.56 - cover * 0.48)) * 2.0);
		gas *= gas;

		float m = saturate(1.0 - KcvFilaments(p * 0.73 + vec3(11.3, 4.7, 8.1), 3, 3.0) * 0.42);
		float dust = saturate((m - (0.72 - saturate(cover * 1.4) * 0.30)) * 5.0);

		// Filaments stay bright inside the cloud, so that its body never goes flat.
		float density = gas * n * n * n * 3.4 * (0.30 + saturate(cover) * 0.70) + cover * cover * 0.06;

		// Emission: deep crimson where thin, rose and then orange-white only in the densest cores.
		float hot = saturate((density - 0.62) * 1.5);
		vec3 emission = mix(vec3(0.78, 0.004, 0.060), vec3(1.0, 0.012, 0.048), saturate(density * 2.4));
		emission = mix(emission, vec3(1.0, 0.040, 0.065), hot);
		emission = mix(emission, vec3(1.0, 0.20, 0.11), hot * hot * hot * 0.8);

		sum += emission * density * tr;
		tr *= exp(-dust * 0.88);
	}
	transmittance = tr;
	sum /= float(steps);
	// Keeps the body deep red and the cores from burning to white under the tonemap.
	return sum / (1.0 + sum.r * 2.4);
}

uvec3 KcvHash(uvec3 v){
	v = v * 1664525u + 1013904223u;
	v.x += v.y * v.z;
	v.y += v.z * v.x;
	v.z += v.x * v.y;
	v ^= v >> 16u;
	v.x += v.y * v.z;
	v.y += v.z * v.x;
	v.z += v.x * v.y;
	return v;
}

// One layer of stars: at most one per cell of a 3D grid, kept only when it lies near the unit sphere, so there is no seam and
// no pole. The eight nearest cells hold every star that can reach this point while it is small against a cell; a layer too
// fine for the render resolution fades out, it never gets narrower than the pixel. The bend curves the lattice a dense layer
// would otherwise show where the sphere runs along a grid plane.
vec3 KcvStarLayer(vec3 d, float cells, float seed, float fill, float gain, float slope, float sigmaAngle, float bandBoost, float bend, float halo){
	float sigmaCells = sigmaAngle * cells;
	float fade = saturate((0.17 - sigmaCells) * 25.0);
	if (fade <= 0.0) return vec3(0.0);
	float invTwoSigma2 = 0.5 / (sigmaCells * sigmaCells);

	vec3 g = normalize(d + sin(d.yzx * 4.3 + seed) * (bend / cells)) * cells;
	ivec3 base = ivec3(floor(g - 0.5));
	vec3 sum = vec3(0.0);
	for (int i = 0; i < 8; i++){
		ivec3 cell = base + ivec3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
		uvec3 h = KcvHash(uvec3(cell + 32768) + uvec3(uint(seed)));
		vec3 r = vec3(h) * (1.0 / 4294967296.0);

		vec3 star = vec3(cell) + 0.2 + r * 0.6;
		float len = length(star);
		if (abs(len - cells) > 0.2) continue;

		vec3 off = star * (cells / len) - g;
		float q = dot(off, off) * invTwoSigma2;
		if (q > (halo > 0.0 ? 120.0 : 7.0)) continue;

		uvec3 h2 = KcvHash(h + 7u);
		vec3 r2 = vec3(h2) * (1.0 / 4294967296.0);
		if (r2.x > fill * bandBoost) continue;

		float mag = gain * min(pow(max(r2.y, 1e-3), -slope), 60.0);
		float temp = r2.z;
		vec3 tint = temp < 0.5 ? mix(vec3(1.0, 0.70, 0.46), vec3(1.0, 0.95, 0.88), temp * 2.0) : mix(vec3(1.0, 0.95, 0.88), vec3(0.72, 0.83, 1.0), temp * 2.0 - 1.0);
		sum += tint * mag * (exp(-q) + halo * exp(-q * 0.07));
	}
	return sum * fade;
}

// What the eye should get, in the units of the pack's tonemap input (colour after exposure).
vec3 KcVoidDisplay(vec3 d){
	float pixelAngle = PixelAngle;

	float bandCoord;
	float mask = KcvCloudMask(d, bandCoord);

	vec3 nebula = vec3(0.0);
	float transmittance = 1.0;
	float detail = clamp(5.7 + log2(0.00194 / pixelAngle) * 0.9, 3.0, 6.0);
	if (mask > 0.0005) nebula = KcvNebula(d, mask, detail, transmittance);
	transmittance = mix(1.0, transmittance, saturate(mask * 30.0));

	// Near-black with a crimson cast, a little warmer along the band.
	float band = exp(-bandCoord * bandCoord * 3.0);
	vec3 color = vec3(0.00125, 0.00020, 0.00038) * (0.55 + band * 1.0);
	color *= mix(0.45, 1.0, transmittance);
	color += nebula * 0.46;

	// A star keeps its light on a finer screen: narrower and brighter (reference: 720 lines at 70 degrees, 1.94 mrad a pixel).
	float sigma = pixelAngle * 0.72;
	float flux = clamp(0.00194 / pixelAngle, 0.5, 3.0);
	flux *= flux;
	float boost = 0.55 + band * 0.9;
	vec3 stars = KcvStarLayer(d, 13.0, 17.0, 0.50, 0.0220 * flux, 1.00, sigma, 1.0, 0.0, 0.05);
	stars += KcvStarLayer(d, 29.0, 53.0, 0.70, 0.0200 * flux, 0.80, sigma, boost, 0.4, 0.0);
	stars += KcvStarLayer(d, 59.0, 91.0, 0.70, 0.0150 * flux, 0.65, sigma, boost, 0.8, 0.0);
	stars += KcvStarLayer(d, 113.0, 131.0, 0.70, 0.0090 * flux, 0.55, sigma, boost, 1.2, 0.0);
	color += stars * mix(0.25, 1.0, transmittance);

	return color;
}

// The display transform of the accepted look: the pack's AgX at its owner's AGX_EV 15.5, with its Abney correction and vignette. The
// AgX fit is the minimal AgX of Benjamin Wrensch (MIT), see SOURCE_AND_LICENSE.md.
vec3 agxContrast(vec3 x) {
    return (((((15.5 * x - 40.14) * x + 31.96) * x - 6.868) * x + 0.4298) * x + 0.1191) * x - 0.00232;
}

vec3 agx(vec3 color) {
    color *= 2.3;
    color *= mat3(0.99999976, -1.26657e-7, -1.29064e-9, 1.67316e-8, 0.99999976, -5.32026e-9, -0.00725587, 6.47740e-9, 1.00725580);
    color *= mat3(0.842479062253094, 0.0784335999999992, 0.0792237451477643, 0.0423282422610123, 0.878468636469772, 0.0791661274605434, 0.0423756549057051, 0.0784336, 0.879142973793104);
    const float hev = 15.5 * 0.5;
    color = clamp(log2(max(color, vec3(1.0e-10)) / 0.18), -hev, hev);
    color = agxContrast((color + hev) / 15.5);
    color *= mat3(1.19687900512017, -0.0980208811401368, -0.0990297440797205, -0.0528968517574562, 1.15190312990417, -0.0989611768448433, -0.0529716355144438, -0.0980434501171241, 1.15107367264116);
    return color;
}

float vignette(vec2 uv) {
    vec2 a = uv * 2.0 - 1.0;
    float rf = dot(a, a) * 0.25 + 1.0;
    return 1.0 / (rf * rf);
}

void main() {
    float coverage = voidCoverage(texCoord);
    if (coverage <= 0.0) discard;
    vec4 far = InvViewProj * vec4(texCoord * 2.0 - 1.0, 1.0, 1.0);
    vec3 color = KcVoidDisplay(normalize(far.xyz / far.w)) * vignette(texCoord);
    fragColor = vec4(saturate(agx(max(color, vec3(0.0)))), coverage);
}
